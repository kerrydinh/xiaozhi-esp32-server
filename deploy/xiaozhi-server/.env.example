# Copy to .env (Dockge: paste into the stack's ".env" editor) and adjust.

# Upstream release of xinnan-tech/xiaozhi-esp32-server (image tags server_X / web_X)
XIAOZHI_VERSION=0.9.8

# Provisioning image built from ./init (see README)
INIT_IMAGE=ghcr.io/kerrydinh/xiaozhi-server-init:latest

# LAN IP or hostname of the Docker host, as the ESP32 device can reach it.
# Used to build the WebSocket/OTA/vision URLs handed to devices.
PUBLIC_HOST=192.168.8.10

# Host ports (change if they clash with other TrueNAS apps)
WEB_PORT=8002
WS_PORT=8000
HTTP_PORT=8003

# Root password for the bundled MySQL. Set once before the first start;
# changing it later does not change the existing database password.
MYSQL_ROOT_PASSWORD=change-me

TZ=Etc/UTC

# Where data is stored. "." = the stack folder. On TrueNAS you may point this
# at a dataset instead, e.g. /mnt/tank/apps/xiaozhi
DATA_ROOT=.

# "en" translates console data (provider names, field labels, help texts,
# dropdowns) to English on each start. Any other value leaves it untouched.
CONSOLE_DATA_LANGUAGE=en

# Download the ~900 MB SenseVoiceSmall model for the default local FunASR ASR.
# Set to false if you only use a remote ASR (e.g. an OpenAI-compatible endpoint).
SENSEVOICE_DOWNLOAD=true

# Optional: speech recognition through an OpenAI-compatible transcription
# endpoint, e.g. Ollama serving Qwen3-ASR (handles Vietnamese, English, ...).
# When set, init creates the ASR model "Ollama Qwen3-ASR" once; select it in
# the agent's role configuration and edit it later in the console.
OLLAMA_ASR_URL=
OLLAMA_ASR_MODEL=
# Example:
# OLLAMA_ASR_URL=http://192.168.8.122:11434/v1/audio/transcriptions
# OLLAMA_ASR_MODEL=hf.co/foryoung365/Qwen3-ASR-1.7B-Q4_K_M-GGUF

# Optional: Vietnamese text-to-speech through a VieNeu-TTS server
# (deploy/vieneu-tts). When set, init creates the TTS model
# "VieNeu-TTS (Vietnamese)" with its 25 preset voices once.
VIENEU_TTS_URL=
VIENEU_TTS_API_KEY=
# Example:
# VIENEU_TTS_URL=http://192.168.8.122:8010/v1/audio/speech

# Mirror for mainland China (SenseVoice model):
# SENSEVOICE_URL=https://modelscope.cn/models/iic/SenseVoiceSmall/resolve/master/model.pt
