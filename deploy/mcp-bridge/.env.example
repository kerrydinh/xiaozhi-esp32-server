# Copy to .env (Dockge: paste into the stack's ".env" editor) and fill in.

MCP_BRIDGE_IMAGE=ghcr.io/kerrydinh/xiaozhi-mcp-bridge:latest
TZ=Etc/UTC

# The agent's MCP endpoint address, from the console:
# Agents > Configure role > Edit functions > MCP endpoint
# (ws://<host>:8004/mcp_endpoint/mcp/?token=...). Keep it secret.
MCP_ENDPOINT=

# Brave Search API key (https://brave.com/search/api/ > dashboard > API keys)
BRAVE_API_KEY=

# Brave tools offered to the agent (space-separated). Available:
# brave_web_search brave_news_search brave_local_search brave_place_search
# brave_video_search brave_image_search brave_summarizer brave_llm_context
# (some need a paid Brave plan)
BRAVE_MCP_ENABLED_TOOLS=brave_web_search brave_news_search
